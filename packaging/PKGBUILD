# Builds pacdeb from this source folder. install.sh in the folder above runs it; by hand:
#   cd packaging && makepkg -f && sudo pacman -U pacdeb-*.pkg.tar.zst

pkgname=pacdeb
pkgver=0.3.0
pkgrel=1
pkgdesc="Install Debian .deb packages as pacman packages and keep them updated, like apt"
arch=('x86_64' 'aarch64')
license=('AGPL-3.0-or-later')
depends=(
  'glibc' 'libgcc' 'xz'
  'pacman'      # makepkg and repo-add
  'sudo' 'gnupg' 'libnotify'
  'gtk4' 'libadwaita' 'pango' 'glib2'
)
makedepends=('cargo' 'git')
# Release builds are already stripped, so no separate debug package. makepkg's LTO
# flags make C code (in the ring crate) into objects Rust's linker cannot read.
options=('!debug' '!lto')
optdepends=('fakeroot: build packages with makepkg (without it pacdeb writes them itself)')
# The folder holding Cargo.toml.
_root="$(realpath "$startdir/..")"

pkgver() {
  sed -n 's/^version = "\(.*\)"$/\1/p' "$_root/Cargo.toml" | head -1
}

build() {
  "$_root/build/build.sh"
}

check() {
  cd "$_root"
  CARGO_HOME="$_root/build/cargo-home" CARGO_TARGET_DIR="$_root/build/target" cargo test --release --quiet
}

package() {
  local bin="$_root/deploy"
  install -Dm755 "$bin/pacdeb" "$pkgdir/usr/bin/pacdeb"
  install -Dm755 "$bin/pacdeb-gui" "$pkgdir/usr/bin/pacdeb-gui"
  install -Dm755 "$_root/setup.sh" "$pkgdir/usr/bin/pacdeb-setup"

  install -d "$pkgdir/usr/share/fish/vendor_completions.d" "$pkgdir/usr/share/bash-completion/completions" "$pkgdir/usr/share/zsh/site-functions"
  "$bin/pacdeb" completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/pacdeb.fish"
  "$bin/pacdeb" completions bash > "$pkgdir/usr/share/bash-completion/completions/pacdeb"
  "$bin/pacdeb" completions zsh > "$pkgdir/usr/share/zsh/site-functions/_pacdeb"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/pacdeb.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=pacdeb
GenericName=Debian Package Converter
Comment=Install .deb apps as pacman packages and keep them updated
Exec=pacdeb-gui %f
Icon=system-software-install
Terminal=false
Categories=System;Settings;PackageManager;
MimeType=application/vnd.debian.binary-package;application/x-deb;
Keywords=deb;debian;package;install;update;
EOF

  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/pacdeb/LICENSE"
  install -Dm644 "$_root/README.md" "$pkgdir/usr/share/doc/pacdeb/README.md"
}
