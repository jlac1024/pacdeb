# Builds pacdeb from this source folder. install.sh in the folder above runs it; by hand:
#   cd packaging && makepkg -f && sudo pacman -U pacdeb-*.pkg.tar.zst
# release/PKGBUILD builds a tagged release from GitHub instead (and is the AUR package).

pkgname=pacdeb
pkgver=0.3.0
pkgrel=1
pkgdesc="Install Debian .deb packages as pacman packages and keep them updated, like apt"
arch=('x86_64' 'aarch64')
url="https://github.com/jlac1024/pacdeb"
license=('AGPL-3.0-or-later')
depends=(
  'glibc' 'libgcc' 'xz'
  'pacman'      # makepkg and repo-add
  'sudo' 'gnupg' 'libnotify'
  'gtk4' 'libadwaita' 'pango' 'glib2'
)
makedepends=('cargo' 'git')
# Release builds are already stripped, so no separate debug package. makepkg's LTO
# flags make C code (in the ring crate) into objects Rust's linker cannot read.
options=('!debug' '!lto')
optdepends=('fakeroot: build packages with makepkg (without it pacdeb writes them itself)')
# The folder holding Cargo.toml.
_root="$(realpath "$startdir/..")"

pkgver() {
  sed -n 's/^version = "\(.*\)"$/\1/p' "$_root/Cargo.toml" | head -1
}

build() {
  "$_root/build/build.sh"
}

check() {
  cd "$_root"
  CARGO_HOME="$_root/build/cargo-home" CARGO_TARGET_DIR="$_root/build/target" cargo test --release --quiet
}

package() {
  "$_root/packaging/package.sh" "$_root/deploy" "$_root" "$pkgdir"
}
